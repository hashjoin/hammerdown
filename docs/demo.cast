[0.013, "o", "\u001b[3J\u001b[H\u001b[2J"]
[0.000, "o", "\r\n\u001b[2m# hammerdown: put the hammer down, keep the brakes.\u001b[0m\r\n"]
[2.009, "o", "\r\n\u001b[2m# A simulated fleet: 11,000 nodes, 2,829 shards, 20 keyspaces, all on v19.0.4.\u001b[0m\r\n"]
[2.010, "o", "\u001b[36m$\u001b[0m \u001b[1mhammerdown sim init --force\u001b[0m\r\n"]
[1.187, "o", "sim: 11000 nodes in .hammerdown/sim-fleet.json (seed=42), all running v19.0.4\r\n"]
[0.001, "o", "\r\n\u001b[2m# Ship v20.0.1. Every node goes RestartWait.\u001b[0m\r\n"]
[2.008, "o", "\u001b[36m$\u001b[0m \u001b[1mhammerdown sim stage --to v20.0.1\u001b[0m\r\n"]
[1.050, "o", "sim: staged v20.0.1 - 10982 node(s) now RestartWait\r\n"]
[0.001, "o", "\u001b[36m$\u001b[0m \u001b[1mhammerdown report --limit 'users|teams|messages|threads'\u001b[0m\r\n"]
[1.049, "o", "            Keyspace|     v19.0.4|     v20.0.1|\r\n--------------------|------------|------------|\r\n            messages|     100.00%|       0.00%|\r\n               teams|     100.00%|       0.00%|\r\n             threads|     100.00%|       0.00%|\r\n               users|     100.00%|       0.00%|\r\n\r\n"]
[2.015, "o", "\r\n\u001b[2m# Full speed: 64 shards in flight. Two shards have a replica that won't catch up.\u001b[0m\r\n"]
[2.008, "o", "\r\n\u001b[2m# --max-primary-failures defaults to 1, so the first bad failover stops everything.\u001b[0m\r\n"]
[2.012, "o", "\u001b[36m$\u001b[0m \u001b[1mhammerdown roll --workers 64 --dry-run=false --yes --sim-cursed 2\u001b[0m\r\n"]
[7.235, "o", "--------- Plan (dry-run=false) ---------\r\nkeyspaces: 20 | shards: 2829 | nodes: 10982 (2829 primaries) | workers: 64\r\n06:43:33 ( worker=01 ) ... ERROR: primary failure: failover messages/3b4b-3b87:db-messages-0252-0.az1.sim -> db-messages-0252-1.az2.sim: planned reparent: db-messages-0252-1.az2.sim replication position did not catch up within 30s\r\n06:43:33 FAIL-FAST: 1 primary failure(s) reached --max-primary-failures=1, stopping\r\n--------- Roll Result ---------\r\nelapsed:            6.162s\r\nshards completed:   1600 / 2829\r\nshards interrupted: 51\r\n"]
[0.000, "o", "shards not started: 1178\r\nprimary failures:   1\r\nreplica failures:   0\r\naborted:            fail-fast threshold breached: 1 primary failure(s)\r\nRe-run the same command to resume: finished nodes are OK and drop out of the plan.\r\n"]
[2.013, "o", "\r\n\u001b[2m# One failure, zero follow-on damage. In-flight shards finished; nothing new started.\u001b[0m\r\n"]
[2.013, "o", "\r\n\u001b[2m# Fix the problem, then run the exact same command to resume.\u001b[0m\r\n"]
[2.013, "o", "\u001b[36m$\u001b[0m \u001b[1mhammerdown roll --workers 64 --dry-run=false --yes\u001b[0m\r\n"]
[5.931, "o", "--------- Plan (dry-run=false) ---------\r\nkeyspaces: 4 | shards: 1230 | nodes: 4788 (1214 primaries) | workers: 64\r\n--------- Roll Result ---------\r\nelapsed:            4.861s\r\nshards completed:   1230 / 1230\r\nshards interrupted: 0\r\nshards not started: 0\r\nprimary failures:   0\r\nreplica failures:   0\r\n"]
[2.013, "o", "\u001b[36m$\u001b[0m \u001b[1mhammerdown report --limit 'users|teams|messages|threads'\u001b[0m\r\n"]
[1.052, "o", "            Keyspace|     v19.0.4|     v20.0.1|\r\n--------------------|------------|------------|\r\n            messages|       0.16%|      99.84%|\r\n               teams|       0.07%|      99.93%|\r\n             threads|       0.28%|      99.72%|\r\n               users|       0.20%|      99.80%|\r\n\r\n"]
[0.007, "o", "\r\n\u001b[2m# The ~0.2% left on v19 are drained nodes: out of service, never touched.\u001b[0m\r\n"]
[2.008, "o", "\r\n\u001b[2m# github.com/hashjoin/hammerdown\u001b[0m\r\n"]
